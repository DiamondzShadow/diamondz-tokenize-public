# Diamondz Tokenize: settings for running your own copy.
#
#   cp tokenize.env.example tokenize.env        # tokenize.env is git-ignored: your keys stay on your machine
#   cd api && bun --env-file=../tokenize.env run src/server.ts
#
# Everything is optional except the first block. Each service switches on when its keys are present; the matching
# feature shows a "being connected" notice until then. Use test/sandbox keys and test networks while you build.

# ---------------------------------------------------------------- 1. Core (needed to sign in to the console)
PORT=8911
# Hosts served by the platform site (comma-separated). Other hosts become white-label tenants.
DEFAULT_HOSTS=localhost,127.0.0.1
# Google Workspace domains allowed into the platform console, and a Google OAuth "Web" client id
# (console.cloud.google.com › APIs & Services › Credentials; add http://localhost:5173 as a JavaScript origin).
ADMIN_DOMAINS=yourcompany.com
GOOGLE_CLIENT_ID=
# Investor + self-serve issuer sign-in (email, Google, passkey, wallets): thirdweb.com › dashboard › client id (32 hex).
THIRDWEB_CLIENT_ID=
# Encrypts two-factor secrets at rest: 32 random bytes as 64 hex characters (openssl rand -hex 32).
MFA_ENC_KEY=

# ---------------------------------------------------------------- 2. Database
# Default: one SQLite file at api/data/tokenize.db. For several API servers use MongoDB Atlas (mongodb.com/atlas).
# STORE=mongo
# MONGO_URI="mongodb+srv://user:pass@cluster.example.mongodb.net/?retryWrites=true&w=majority"   # keep the quotes
# MONGO_DB=tokenize
# DB_PATH=./data/tokenize.db

# ---------------------------------------------------------------- 3. Chains
# RPC: Uniblock (uniblock.dev) serves every EVM chain in web/src/lib/chains.ts with one key; public RPCs are the fallback.
UNIBLOCK_API_KEY=
# Per-chain override, e.g. a local anvil: RPC_84532=http://127.0.0.1:8545
# Platform wallets (testnet keys from `cast wallet new`; fund each with test gas from the network's faucet):
#   TREX_RELAYER_KEY     deploys ERC-3643 suites and relays gasless attestations
#   PAYOUT_RELAYER_KEY   delivers payouts and pays claim gas for holders
#   ESIGN_ATTESTER_KEY   records Adobe-signed checks on each oracle (approve it: web/scripts/oracle.ts add-verifier)
#   MC_DATA_SOURCE_KEY   signs bank-backed income checks
TREX_RELAYER_KEY=
PAYOUT_RELAYER_KEY=
ESIGN_ATTESTER_KEY=
MC_DATA_SOURCE_KEY=

# ---------------------------------------------------------------- 4. Email (lawyer links, codes, contact-form alerts)
# resend.com › API keys; NOTIFY_FROM must be on a domain you verified in Resend.
RESEND_API_KEY=
NOTIFY_FROM="Diamondz Tokenize <notify@yourdomain.com>"
LEADS_NOTIFY_TO=

# ---------------------------------------------------------------- 5. Investor identity checks
# Sumsub (sumsub.com › Dev space › App tokens + webhook secret). Without Sumsub, Stripe Identity runs the check.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
# SUMSUB_LEVEL=id-and-liveness
# Stripe (dashboard.stripe.com › Developers): company verification (Connect), Identity, bank links.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- 6. Signed checks + lawyer sign-off
# Adobe Acrobat Sign: free developer account at adobe.com/sign/developer-form.html,
# then Account › Acrobat Sign API › API Information › Integration Key (user_read, agreement_read/write/send,
# webhook_read/write). After the first start, open Console › Signing log › Register notifications.
ADOBE_SIGN_INTEGRATION_KEY=

# ---------------------------------------------------------------- 7. Accreditation + bank proof (Mastercard Open Finance)
# Calls go through the US relay in mc-relay/ (deploy it to Cloud Run with your Mastercard sandbox credentials).
MC_RELAY_URL=
MC_RELAY_TOKEN=
MC_OF_TESTING=1

# ---------------------------------------------------------------- 8. Market data + filings
# SEC EDGAR asks every client for a contact in its User-Agent: "Your Company admin@yourcompany.com".
SEC_EDGAR_UA=
# Optional fallbacks and charts: sec-api.io, massive.com (stocks + indices), fred.stlouisfed.org.
SEC_API_KEY=
MASSIVE_API_KEY=
FRED_API_KEY=

# ---------------------------------------------------------------- 9. Background jobs
# Local runs use in-process timers. With Temporal Cloud (temporal.io), set TEMPORAL_JOBS=1 here and run
# temporal/tokenize_temporal.py with TEMPORAL_ADDRESS, TEMPORAL_NAMESPACE, TEMPORAL_API_KEY and the same token.
# TEMPORAL_JOBS=1
INTERNAL_JOB_TOKEN=
